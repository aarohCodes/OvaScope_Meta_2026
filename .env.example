# OvaScope configuration. Copy to .env and edit. Placeholders only: never commit real secrets.

# local | public. "public" refuses to start without OVASCOPE_API_TOKEN (>= 24 chars).
OVASCOPE_DEPLOYMENT=local
# OVASCOPE_API_TOKEN=replace-with-a-long-random-token

# Database: SQLite by default; Docker Compose sets PostgreSQL.
# OVASCOPE_DATABASE_URL=postgresql+psycopg://ovascope:CHANGE_ME@localhost:5432/ovascope

# Comma-separated allowed browser origins (the Next.js app).
OVASCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload and processing limits
OVASCOPE_MAX_UPLOAD_BYTES=20971520
OVASCOPE_MAX_IMAGE_PIXELS=40000000
OVASCOPE_UPLOADS_PER_MINUTE=30
OVASCOPE_MAX_QUEUED_JOBS=20
OVASCOPE_SEGMENTATION_TIMEOUT_S=90

# Retention: uploaded studies and all derived artifacts are deleted after this many hours.
OVASCOPE_RETENTION_HOURS=24

# auto: use the ACTIVE model bundle if present and valid; no_model: force NO_MODEL mode.
OVASCOPE_INFERENCE_MODE=auto
# OVASCOPE_BUNDLE_ID=

# Run jobs in a thread inside the API (dev). Set false when running services/worker.
OVASCOPE_INLINE_WORKER=true

# Serve held-out failure-case images on the evaluation page (local research use only).
OVASCOPE_SERVE_EVAL_IMAGES=false

# Hosted providers are not configured. External transmission fails closed.
# OVASCOPE_MULTIMODAL_PROVIDER=

# Optional Modal adapter (infra/modal). Credentials are read by the Modal CLI, never by OvaScope.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Web app (server-side only; never exposed to the browser)
OVASCOPE_API_INTERNAL_URL=http://127.0.0.1:8000
